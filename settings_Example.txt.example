# positions are meters and scale with your avatar, rotations are degrees.
# xyz isnt the same direction everywhere, check the note above each one.

# VRM model scale
ModelScale=1.0

# chair sitting offset. x = right, y = up, z = forward
SittingOnChairOffset=<0, 0, 0>

# weapon and tool nudges. Pos goes along that slots own axes, not right/up/forward,
# so try small numbers to see which way it moves. Rot spins the item.
RightHandItemPos=<0, 0, 0>
RightHandItemRot=<0, 0, 0>
LeftHandItemPos=<0, 0, 0>
LeftHandItemRot=<0, 0, 0>
RightHandBackItemPos=<0, 0, 0>
RightHandBackItemRot=<0, 0, 0>
LeftHandBackItemPos=<0, 0, 0>
LeftHandBackItemRot=<0, 0, 0>
# Scale all weapons, or name a weapon to scale it independently.
WeaponScale=1.0
#WeaponScale=BowDraugrFang,1.2
# Per weapon class, added on top of the slot values above. Plain = stowed on the back,
# add Hand for held. Put a prefab name in front to hit one weapon only; that line
# replaces its class line. Classes: Bow Crossbow Sword Knife Club Axe Spear Polearm
# Staff Shield Tool Pickaxe Torch Fist (Mace=Club, Atgeir=Polearm, Hammer=Tool)
#BowPos=<0, 0.02, 0>
#BowPos=BowDraugrFang,<0, 0.03, 0>
#KnifeRot=<0, 0, 15>
#SwordHandPos=<0, -0.01, 0>
# rigged weapons (Skoll and Hati, Berserkir axes, fists) ignore the lines above. each piece gets its own,
# item name then LeftHand RightHand LeftForeArm or RightForeArm, then Pos or Rot. Rot spins it where its held.
#KnifeSkollAndHatiLeftHandPos=<0, 0.01, 0>
#KnifeSkollAndHatiRightHandRot=<0, 0, 15>

# Vanilla helmet visibility and additional scale/position adjustment.
HelmetVisible=false
HelmetScale=<1, 1, 1>
HelmetOffset=<0, 0, 0>
# Vanilla armor visibility.
ChestVisible=false
ShouldersVisible=false
UtilityVisible=false
TrinketVisible=false
LegsVisible=false

# Material brightness and optional asynchronous texture conversion.
ModelBrightness=1.0
# which game shader the texture fix uses. player = the normal character shader. creature = the animal shader,
# creature is the only one that can glow, needed for TextureFixEmission to do anything.
ShaderForTextureFix=player
AttemptTextureFix=false
# only with ShaderForTextureFix=creature: how much the avatar glows with its own colors so it does not go black in shadow. 0 to 1.
TextureFixEmission=0.15
# Use the MToon shader (texture conversion takes precedence).
UseMToonShader=false
# only blendshapes the vrm expressions or your outfit file use get loaded, the rest stay empty so models with hundreds of them load faster and cause less of a frame spike.
# true loads all of them.
KeepAllBlendShapes=false
# Camera height follows the avatar, with optional close-camera fading.
FixCameraHeight=true
EnablePlayerFade=false

# Multipliers on the avatar's authored spring settings.
SpringBoneStiffness=1.0
SpringBoneGravityPower=1.0
# same as Immobile on a physbone. 0 to 1, how much of your movement the springs ignore.
# turn it up if hair, fur or the tongue gets pulled way out of place when you run.
# a name in front does one spring group only (unity spring bone comment or root bone).
SpringBoneImmobile=0
#SpringBoneImmobile=Neckfloof,1
# World = only ignores you moving around. AllMotion = ignores the animation too.
SpringBoneImmobileType=World
# same as the angle limit on a physbone. how many degrees a spring bone can swing away from where it rests.
# 0 = off, a vrm 1.0 avatar then keeps any limits it was exported with. a name in front does one spring
# group only, same names as SpringBoneImmobile.
SpringBoneMaxAngle=0
#SpringBoneMaxAngle=Ears,18

# Gameplay interaction distance multiplier; weapon attack range is unchanged.
InteractionDistanceScale=1.0
# Permit this character's bundle and sharing key to be supplied to other game players.
AllowShare=true
