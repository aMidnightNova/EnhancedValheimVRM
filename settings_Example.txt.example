# VRM model scale
ModelScale=1.1

# Generic equipment adjustments in socket-local metres / Euler degrees.
# Positions scale with avatar height; original prefab grip rotations are preserved.
RightHandItemPos=<0, 0, 0>
RightHandItemRot=<0, 0, 0>
LeftHandItemPos=<0, 0, 0>
LeftHandItemRot=<0, 0, 0>
RightHandBackItemPos=<0, 0, 0>
RightHandBackItemRot=<0, 0, 0>
LeftHandBackItemPos=<0, 0, 0>
LeftHandBackItemRot=<0, 0, 0>
# Per weapon class, added on top of the slot values above. Plain = stowed on the back,
# add Hand for held. Put a prefab name in front to hit one weapon only; that line
# replaces its class line. Classes: Bow Crossbow Sword Knife Club Axe Spear Polearm
# Staff Shield Tool Pickaxe Torch Fist (Mace=Club, Atgeir=Polearm, Hammer=Tool)
#BowPos=<0, 0.02, 0>
#BowPos=BowDraugrFang,<0, 0.03, 0>
#KnifeRot=<0, 0, 15>
#SwordHandPos=<0, -0.01, 0>

# Vanilla helmet visibility and additional scale/position adjustment.
HelmetVisible=false
HelmetScale=<1, 1, 1>
HelmetOffset=<0, 0, 0>
# Vanilla armor visibility.
ChestVisible=false
ShouldersVisible=false
UtilityVisible=false
LegsVisible=false

# Material brightness and optional asynchronous texture conversion.
ModelBrightness=1.0
# which game shader the texture fix uses. player = the normal character shader. creature = the animal shader,
# creature is the only one that can glow, needed for TextureFixEmission to do anything.
ShaderForTextureFix=player
AttemptTextureFix=false
# only with ShaderForTextureFix=creature: how much the avatar glows with its own colors so it does not go black in shadow. 0 to 1.
TextureFixEmission=0.15
# Use the MToon shader (texture conversion takes precedence).
UseMToonShader=false
# Camera height follows the avatar, with optional close-camera fading.
FixCameraHeight=true
EnablePlayerFade=true

# Multipliers on the avatar's authored spring settings.
SpringBoneStiffness=1.0
SpringBoneGravityPower=1.0
# Gameplay interaction distance multiplier; weapon attack range is unchanged.
InteractionDistanceScale=1.0
# Permit this character's bundle and sharing key to be supplied to viewers.
AllowShare=true
