    <!-- BepInEx: the r2modman profile first, then the game dir -->
    <R2_PROFILE Condition="'$(R2_PROFILE)' == ''">meow</R2_PROFILE>
    <BEPINEX_DIR Condition="'$(BEPINEX_DIR)' == '' and Exists('$(HOME)/.config/r2modmanPlus-local/Valheim/profiles/$(R2_PROFILE)/BepInEx/core/BepInEx.dll')">$(HOME)/.config/r2modmanPlus-local/Valheim/profiles/$(R2_PROFILE)/BepInEx</BEPINEX_DIR>
