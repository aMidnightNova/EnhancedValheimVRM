  <Target Name="ValidateGamePaths" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(VALHEIM_INSTALL)/valheim_Data/Managed/assembly_valheim.dll')"
           Text="VALHEIM_INSTALL must point to the Valheim installation used for this build."/>
    <Error Condition="!Exists('$(BEPINEX_DIR)/core/BepInEx.dll')"
           Text="BepInEx was not found under BEPINEX_DIR/core (default VALHEIM_INSTALL/BepInEx)."/>
    <Error Condition="!Exists('$(UNIVRM_UNITY_LIBS)/Managed/VRM.dll')"
           Text="UNIVRM_UNITY_LIBS must point to the data directory containing Managed/VRM.dll."/>
  </Target>


  <!-- R2ModMan config: overwrite the files inside the profiles mod folder.
       import the thunderstore zip once so r2modman knows the mod,
       after that this keeps the dll and shaders current. -->
  <Target Name="DeployR2ModMan" AfterTargets="Build" Condition="'$(Configuration)' == 'R2ModMan'">
    <PropertyGroup>
      <R2ModFolder>$(BEPINEX_DIR)/plugins/$(ThunderstoreNamespace)-EnhancedValheimVRM</R2ModFolder>
    </PropertyGroup>
    <Error Condition="!Exists('$(R2ModFolder)')"
           Text="$(R2ModFolder) does not exist. import the thunderstore zip into the $(R2_PROFILE) profile first."/>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(R2ModFolder)"/>
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(R2ModFolder)"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
    <Copy SourceFiles="$(EnhancedProjectRoot)/shaders/UniVRM.shaders" DestinationFiles="$(R2ModFolder)/UniVrm.shaders"/>
    <Copy SourceFiles="$(EnhancedProjectRoot)/shaders/OldUniVrm.shaders" DestinationFolder="$(R2ModFolder)"/>
    <Message Importance="high" Text="Deployed to $(R2ModFolder)"/>
  </Target>

  <!-- debug/release deploy into the game dir only while bepinex is actually installed there. on r2modman the
       game dir is vanilla, so this stays out of it and the R2ModMan config is the one that deploys -->
  <Target Name="SkipDeployWithoutGameBepInEx" AfterTargets="Build"
          Condition="'$(DeployToGame)' != 'false' and '$(Configuration)' != 'R2ModMan' and !Exists('$(VALHEIM_INSTALL)/BepInEx/core/BepInEx.dll')">
    <Message Importance="high" Text="No BepInEx in $(VALHEIM_INSTALL), not deploying. Use the R2ModMan configuration for profile testing."/>
  </Target>

  <Target Name="DeployLinuxBuild" AfterTargets="Build"
          Condition="'$(OS)' != 'Windows_NT' and '$(DeployToGame)' != 'false' and '$(Configuration)' != 'R2ModMan' and Exists('$(VALHEIM_INSTALL)/BepInEx/core/BepInEx.dll')">
    <PropertyGroup>
      <BepInExPluginPath Condition="'$(BepInExPluginPath)' == ''">$(VALHEIM_INSTALL)/BepInEx/plugins</BepInExPluginPath>
      <EnhancedVrmDataPath Condition="'$(EnhancedVrmDataPath)' == ''">$(VALHEIM_INSTALL)/EnhancedValheimVRM</EnhancedVrmDataPath>
    </PropertyGroup>
    <MakeDir Directories="$(BepInExPluginPath);$(EnhancedVrmDataPath)/shaders"/>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPluginPath)"/>
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BepInExPluginPath)"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
    <Copy SourceFiles="$(EnhancedProjectRoot)/shaders/UniVRM.shaders"
          DestinationFiles="$(EnhancedVrmDataPath)/shaders/UniVrm.shaders"/>
    <Copy SourceFiles="$(EnhancedProjectRoot)/shaders/OldUniVrm.shaders"
          DestinationFolder="$(EnhancedVrmDataPath)/shaders"/>
    <Delete Files="$(BepInExPluginPath)/$(TargetFileName).mdb"/>
    <Delete Files="$(BepInExPluginPath)/$(TargetName).pdb"
            Condition="!Exists('$(TargetDir)$(TargetName).pdb')"/>
    <Message Importance="high" Text="Deployed $(TargetFileName) and debug symbols to $(BepInExPluginPath), shaders to $(EnhancedVrmDataPath)/shaders."/>
  </Target>

  <Target Name="PackageLinuxRelease" AfterTargets="Build" BeforeTargets="DeployLinuxBuild"
          Condition="'$(OS)' != 'Windows_NT' and '$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ReleasePackageRoot>$(EnhancedProjectRoot)/artifacts/release-package</ReleasePackageRoot>
      <ReleasePath>$(ReleasePackageRoot)/release</ReleasePath>
      <ReleaseArchive>$(EnhancedProjectRoot)/artifacts/EnhancedValheimVRM-$(Version).zip</ReleaseArchive>
      <FreeImagePath>$(UNIVRM_UNITY_LIBS)/Plugins/x86_64/FreeImage.dll</FreeImagePath>
      <FreeImagePath Condition="!Exists('$(FreeImagePath)')">$(UNIVRM_UNITY_LIBS)/Managed/FreeImage.dll</FreeImagePath>
    </PropertyGroup>
    <ItemGroup>
      <ReleaseLibraryName Include="FastSpringBone;FastSpringBone10;MToon;UniGLTF;UniHumanoid;VRM;VRM10;VrmLib;UniGLTF.Utils"/>
      <ReleaseLibraryName Include="VRMShaders.GLTF.IO.Runtime;VRMShaders.GLTF.UniUnlit.Runtime;VRMShaders.VRM.IO.Runtime;VRMShaders.VRM10.Format.Runtime;VRMShaders.VRM10.MToon10.Runtime"/>
      <ReleaseLibraryName Include="AsyncImageLoader.Runtime;Unity.Burst;Unity.Mathematics"/>
      <ReleaseLibrary Include="@(ReleaseLibraryName->'$(UNIVRM_UNITY_LIBS)/Managed/%(Identity).dll')"/>
      <ReleaseLibrary Include="$(FreeImagePath)"/>
      <ReleaseDocumentation Include="$(EnhancedProjectRoot)/README.md;$(EnhancedProjectRoot)/WEAPONS.md;$(EnhancedProjectRoot)/outfits_Example.txt.example;$(EnhancedProjectRoot)/settings_Example.txt.example;$(EnhancedProjectRoot)/settings____Default.txt.example"/>
    </ItemGroup>
    <RemoveDir Directories="$(ReleasePackageRoot)"/>
    <MakeDir Directories="$(ReleasePath)/BepInEx/plugins;$(ReleasePath)/valheim_Data/Managed;$(ReleasePath)/EnhancedValheimVRM/shaders"/>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ReleasePath)/BepInEx/plugins"/>
    <Copy SourceFiles="$(EnhancedProjectRoot)/shaders/UniVRM.shaders"
          DestinationFiles="$(ReleasePath)/EnhancedValheimVRM/shaders/UniVrm.shaders"/>
    <Copy SourceFiles="$(EnhancedProjectRoot)/shaders/OldUniVrm.shaders"
          DestinationFolder="$(ReleasePath)/EnhancedValheimVRM/shaders"/>
    <Copy SourceFiles="@(ReleaseLibrary)" DestinationFolder="$(ReleasePath)/valheim_Data/Managed"/>
    <Copy SourceFiles="@(ReleaseDocumentation)" DestinationFolder="$(ReleasePath)/EnhancedValheimVRM"/>
    <ZipDirectory SourceDirectory="$(ReleasePackageRoot)" DestinationFile="$(ReleaseArchive)" Overwrite="true"/>
    <Message Importance="high" Text="Created release archive: $(ReleaseArchive)"/>
    <CallTarget Targets="PackageThunderstoreRelease"/>
  </Target>

  <Target Name="PackageThunderstoreRelease" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ThunderstorePackageRoot Condition="'$(OS)' != 'Windows_NT'">$(EnhancedProjectRoot)/artifacts/thunderstore-package</ThunderstorePackageRoot>
      <ThunderstoreArchive Condition="'$(OS)' != 'Windows_NT'">$(EnhancedProjectRoot)/artifacts/$(ThunderstoreNamespace)-EnhancedValheimVRM-$(Version).zip</ThunderstoreArchive>
      <ThunderstoreReleasePath Condition="'$(OS)' != 'Windows_NT'">$(EnhancedProjectRoot)/artifacts/release-package/release/</ThunderstoreReleasePath>
      <ThunderstorePackageRoot Condition="'$(OS)' == 'Windows_NT'">$(SolutionDir)packaged\thunderstore-package</ThunderstorePackageRoot>
      <ThunderstoreArchive Condition="'$(OS)' == 'Windows_NT'">$(SolutionDir)packaged\$(ThunderstoreNamespace)-EnhancedValheimVRM-$(Version).zip</ThunderstoreArchive>
      <ThunderstoreReleasePath Condition="'$(OS)' == 'Windows_NT'">$(SolutionDir)release\</ThunderstoreReleasePath>
      <ThunderstoreManifest>{
        &quot;name&quot;: &quot;EnhancedValheimVRM&quot;,
        &quot;version_number&quot;: &quot;$(Version)&quot;,
        &quot;website_url&quot;: &quot;https://github.com/aMidnightNova/EnhancedValheimVRM&quot;,
        &quot;description&quot;: &quot;Enhanced VRM avatar support for Valheim.&quot;,
        &quot;dependencies&quot;: [
        &quot;denikson-BepInExPack_Valheim-5.4.2350&quot;
        ]
        }
      </ThunderstoreManifest>
    </PropertyGroup>
    <RemoveDir Directories="$(ThunderstorePackageRoot)"/>
    <MakeDir Directories="$(ThunderstorePackageRoot)"/>
    <ItemGroup>
      <!-- the github readme stays out of the thunderstore zip -->
      <ThunderstoreRuntimeFile Include="$(ThunderstoreReleasePath)**/*" Exclude="$(ThunderstoreReleasePath)EnhancedValheimVRM/README.md"/>
    </ItemGroup>
    <Copy SourceFiles="@(ThunderstoreRuntimeFile)"
          DestinationFiles="@(ThunderstoreRuntimeFile->'$(ThunderstorePackageRoot)/%(RecursiveDir)%(Filename)%(Extension)')"/>
    <Copy SourceFiles="$(EnhancedProjectRoot)/thunderstore/README.md" DestinationFolder="$(ThunderstorePackageRoot)"/>
    <Copy SourceFiles="$(EnhancedProjectRoot)/icon.png" DestinationFolder="$(ThunderstorePackageRoot)"/>
    <WriteLinesToFile File="$(ThunderstorePackageRoot)/manifest.json"
                      Lines="$(ThunderstoreManifest)" Overwrite="true" Encoding="ASCII"/>
    <ZipDirectory SourceDirectory="$(ThunderstorePackageRoot)"
                  DestinationFile="$(ThunderstoreArchive)" Overwrite="true"/>
    <RemoveDir Directories="$(ThunderstorePackageRoot)"/>
    <Message Importance="high" Text="Created Thunderstore archive: $(ThunderstoreArchive)"/>
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent"
          Condition="'$(OS)' == 'Windows_NT' and '$(DeployToGame)' != 'false' and '$(Configuration)' != 'R2ModMan' and Exists('$(VALHEIM_INSTALL)/BepInEx/core/BepInEx.dll')">
    <!-- Set Paths -->
    <PropertyGroup>
      <BepInExPluginPath>$(VALHEIM_INSTALL)\BepInEx\plugins\</BepInExPluginPath>
      <ManagedPath>$(VALHEIM_INSTALL)\valheim_Data\Managed\</ManagedPath>
      <ValheimInstallPath>$(VALHEIM_INSTALL)\</ValheimInstallPath>
      <UniVrmLibsPathManaged>$(UNIVRM_UNITY_LIBS)\Managed</UniVrmLibsPathManaged>
      <UniVrmLibsPathPlugins>$(UNIVRM_UNITY_LIBS)\Plugins\x86_64</UniVrmLibsPathPlugins>
      <Pdb2MdbPath>$(SolutionDir)pdb2mdb.exe</Pdb2MdbPath>
      <!--      <UnstrippedCorlibPath>$(VALHEIM_INSTALL)\unstripped_corlib\</UnstrippedCorlibPath>-->
    </PropertyGroup>

    <PropertyGroup>
      <ReleasePath>$(SolutionDir)release\</ReleasePath>
      <ReleaseManagedPath>$(ReleasePath)valheim_Data\Managed\</ReleaseManagedPath>
      <ReleasePluginPath>$(ReleasePath)BepInEx\plugins\</ReleasePluginPath>
    </PropertyGroup>


    <!-- Delete old files from BepInExPluginPath -->
    <Exec Command="del &quot;$(BepInExPluginPath)$(TargetFileName)&quot;"/>
    <Exec Command="del &quot;$(BepInExPluginPath)$(TargetName).pdb&quot;"/>
    <Exec Command="del &quot;$(BepInExPluginPath)$(TargetFileName).mdb&quot;"/>

    <!-- Copyable files -->
    <ItemGroup>
      <!-- UNI VRM -->
      <LibFiles Include="$(UniVrmLibsPathManaged)\FastSpringBone.dll"/>
      <LibFiles Include="$(UniVrmLibsPathManaged)\FastSpringBone10.dll"/>
      <LibFiles Include="$(UniVrmLibsPathManaged)\MToon.dll"/>
      <LibFiles Include="$(UniVrmLibsPathManaged)\UniGLTF.dll"/>
      <LibFiles Include="$(UniVrmLibsPathManaged)\UniHumanoid.dll"/>
      <LibFiles Include="$(UniVrmLibsPathManaged)\VRM.dll"/>
      <LibFiles Include="$(UniVrmLibsPathManaged)\VRM10.dll"/>
      <LibFiles Include="$(UniVrmLibsPathManaged)\VrmLib.dll"/>
      <LibFiles Include="$(UniVrmLibsPathManaged)\UniGLTF.Utils.dll"/>

      <LibFiles Include="$(UniVrmLibsPathManaged)\VRMShaders.GLTF.IO.Runtime.dll"/>
      <LibFiles Include="$(UniVrmLibsPathManaged)\VRMShaders.GLTF.UniUnlit.Runtime.dll"/>
