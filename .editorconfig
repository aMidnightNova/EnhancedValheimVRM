# formatting rules so rider / resharper keep the code in the original style
# (braces, one statement per line, no packed one-liner blocks).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120

# braces on their own line, always
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# no `a; b;` on one line. (do not add csharp_preserve_single_line_blocks=false or
# resharper place_simple_blocks_on_single_line=false here: resharper maps both onto the
# same switch that expands `{ get; set; }` out.)
csharp_preserve_single_line_statements = false

# indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_block_contents = true
csharp_indent_braces = false

# spacing
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_after_cast = false
csharp_space_around_binary_operators = before_and_after

# style prefs (suggestions only, reformat does not rewrite these)
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = when_multiline:suggestion

# resharper / rider specific
resharper_csharp_brace_style = next_line
resharper_csharp_place_simple_embedded_statement_on_same_line = if_owner_is_single_line
resharper_csharp_place_simple_case_statement_on_same_line = false
resharper_csharp_place_simple_anonymousmethod_on_single_line = true
resharper_csharp_place_simple_initializer_on_single_line = true
resharper_csharp_place_abstract_accessorholder_on_single_line = true
resharper_csharp_place_simple_accessorholder_on_single_line = true
resharper_csharp_keep_existing_declaration_block_arrangement = false
resharper_csharp_place_simple_accessor_on_single_line = true
resharper_csharp_keep_existing_linebreaks = true
resharper_csharp_keep_existing_embedded_arrangement = false
resharper_csharp_keep_existing_arrangement = false
resharper_csharp_wrap_lines = true
resharper_csharp_max_line_length = 120
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_csharp_wrap_chained_method_calls = chop_if_long
resharper_csharp_wrap_before_binary_opsign = false
resharper_csharp_align_multiline_binary_expressions_chain = false
resharper_csharp_align_multiline_expression = false
resharper_csharp_wrap_before_ternary_opsigns = true
resharper_csharp_wrap_ternary_expr_style = chop_if_long
resharper_csharp_wrap_after_declaration_lpar = false
resharper_csharp_wrap_after_invocation_lpar = false
resharper_csharp_place_type_attribute_on_same_line = false
resharper_csharp_place_method_attribute_on_same_line = false
resharper_csharp_place_accessorholder_attribute_on_same_line = false
resharper_csharp_place_field_attribute_on_same_line = if_owner_is_single_line
resharper_csharp_blank_lines_around_single_line_field = 0
resharper_csharp_blank_lines_around_single_line_property = 0
resharper_csharp_blank_lines_around_single_line_auto_property = 0
resharper_csharp_blank_lines_around_field = 1
resharper_csharp_blank_lines_around_property = 1
resharper_csharp_blank_lines_around_method = 1
resharper_csharp_blank_lines_around_type = 1
resharper_csharp_remove_blank_lines_near_braces_in_code = true
resharper_csharp_remove_blank_lines_near_braces_in_declarations = true
resharper_csharp_keep_blank_lines_in_code = 2
resharper_csharp_keep_blank_lines_in_declarations = 2
resharper_csharp_empty_block_style = together_same_line

[*.{csproj,sln,props,targets}]
indent_style = space
indent_size = 2
