# Use your VRM's exact renderer and blendshape names.
# Exactly one section must contain Default=True; its name can be anything.
[Everyday]
Default=True
mesh:Body=True
mesh:Shirt=True
mesh:Hoodie=False

[Winter]
Default=False
mesh:Body=True
mesh:Shirt=False
mesh:Hoodie=True

# Blendshapes unused by VRM expressions or outfits are stripped.
# List the blendshapes you want to keep here.
# Run "/vrm outfit blendshapes" to generate a commented list of all blendshapes in your VRM.
[Blendshapes]
jawOpen
